{
  "name": "ts-unused",
  "version": "3.7.1",
  "description": "Find unused exports and properties in TypeScript projects",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexgorbatchev/ts-unused.git"
  },
  "license": "MIT",
  "bin": {
    "ts-unused": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "packageManager": "bun@1.4.3",
  "devDependencies": {
    "@alexgorbatchev/typescript-ai-policy": "^14.0.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/yargs": "17.0.35",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "execa": "10.2.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0"
  },
  "dependencies": {
    "ts-morph": "^28.0.0",
    "yargs": "18.2.0"
  }
}
